title = "👁️🔶👁️"
shell-integration = zsh
background-opacity = 1
font-size = 18
# Load-bearing: rose-pine's ANSI 1-7 are pastels, but p10k's rainbow style pairs
# them with near-white foregrounds (DIR_FOREGROUND=254 on palette 4). This is what
# keeps those segments readable. Also lifts nvim's dim comment text.
minimum-contrast = 1.8
window-padding-y = 2,1
window-padding-x = 1
# Match nvim + tmux, which both run rose-pine main. nvim is transparent, so its
# colors land on this background — a Moon base washed main's contrast out.
theme = "Rose Pine"
mouse-hide-while-typing = true
