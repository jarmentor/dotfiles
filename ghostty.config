title = "👁️🔶👁️"
shell-integration = zsh
background-opacity = 1
font-size = 18
# rose-pine's ANSI 1-7 are pastels, p10k's rainbow assumes they're dark
minimum-contrast = 1.8
window-padding-y = 2,1
window-padding-x = 1
# main, not moon — nvim runs transparent on this background
theme = "Rose Pine"
mouse-hide-while-typing = true
# ssh-* scope the TERM downgrade to ssh; the rest is ghostty's default set, which
# this key replaces wholesale
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path
